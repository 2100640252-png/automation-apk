<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 链接解析需要联网跟随公开跳转；不登录、不读密码。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.smile.gifmaker" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.bilibili.app.in" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.sina.weibo" />
        <package android:name="com.twitter.android" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="自动化工作"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutomationWork">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AutomationWork">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 唯一无障碍服务：控制核心。悬浮按钮由这个服务用 TYPE_ACCESSIBILITY_OVERLAY 添加。 -->
        <service
            android:name=".AutomationService"
            android:exported="false"
            android:label="自动化屏幕控制"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
